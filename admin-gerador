<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8">
  <title>Lista Pessoal Autenticada - Gerador de Código</title>
  <style>
    body {
      /* Estilo do corpo da página */
      font-family: "Segoe UI", sans-serif;
      background: #f3f3f3;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 20px;
      margin: 0;
    }

    h1 {
      /* Estilo do título principal */
