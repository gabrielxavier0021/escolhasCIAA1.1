      <div style="margin-top: 20px; display: flex; gap: 10px; justify-content: flex-end;">
        <!-- Container dos botões do modal -->
        <button id="restaurarPadrao" style="background: #6c757d;">Restaurar Padrão</button>
        <!-- Botão restaurar padrão -->
