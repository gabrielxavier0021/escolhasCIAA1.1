      <!-- Descrição do modal -->

      <div class="add-om-form">
        <!-- Formulário para adicionar OM -->
        <input type="text" id="novaOM" placeholder="Digite o nome da nova OM" maxlength="50">
        <!-- Input para nova OM -->
        <button id="adicionarOM" class="btn-adicionar">Adicionar OM</button>
        <!-- Botão adicionar OM -->
      </div>

      <div class="oms-list" id="listaOMs">
        <!-- Lista de OMs existentes -->
        <!-- Lista de OMs será gerada dinamicamente aqui -->
