    .btn-sistema {
      /* Botões do sistema */
      padding: 15px 30px;
      background: #3498db;
      color: white;
      border: none;
      border-radius: 8px;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s ease;
    }

    .btn-sistema:hover {
      /* Efeito hover nos botões do sistema */
      background: #2980b9;
      transform: translateY(-2px);
    }

    .btn-sistema.ativo {
      /* Botão do sistema ativo */
      background: #2c3e50;
    }

    /* Modal para gerenciamento de OMs */
    .modal {
      /* Modal genérico */
      display: none;
      position: fixed;
      z-index: 1000;
      left: 0;
      top: 0;
      width: 100%;
      height: 100%;
      background-color: rgba(0, 0, 0, 0.5);
    }

    .modal-content {
      /* Conteúdo do modal */
      background-color: white;
      margin: 5% auto;
      padding: 30px;
      border-radius: 12px;
      width: 90%;
      max-width: 600px;
      max-height: 80vh;
      overflow-y: auto;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
    }

    .close {
      /* Botão fechar do modal */
      color: #aaa;
      float: right;
      font-size: 28px;
      font-weight: bold;
      cursor: pointer;
    }

    .close:hover {
      /* Efeito hover no botão fechar */
      color: #000;
    }

    .oms-list {
      /* Lista de OMs no modal */
      margin: 20px 0;
      max-height: 300px;
      overflow-y: auto;
      border: 1px solid #ddd;
      border-radius: 8px;
      padding: 10px;
    }

    .om-item {
      /* Item individual da lista de OMs */
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 10px;
      border-bottom: 1px solid #eee;
    }

    .om-item:last-child {
      /* Remove borda do último item */
      border-bottom: none;
    }

    .om-item span {
      /* Texto do item de OM */
      flex-grow: 1;
    }

    .btn-excluir {
      /* Botão excluir OM */
      background: #dc3545;
      color: white;
      border: none;
      padding: 5px 10px;
      border-radius: 4px;
      cursor: pointer;
      font-size: 12px;
    }

    .btn-excluir:hover {
      /* Efeito hover no botão excluir */
      background: #c82333;
    }

    .add-om-form {
      /* Formulário para adicionar OM */
      display: flex;
      gap: 10px;
      margin-top: 20px;
    }

    .add-om-form input {
      /* Input do formulário de adicionar OM */
      flex-grow: 1;
    }

    .btn-adicionar {
      /* Botão adicionar OM */
      background: #28a745;
      color: white;
      border: none;
      padding: 10px 15px;
      border-radius: 6px;
      cursor: pointer;
      white-space: nowrap;
    }

    .btn-adicionar:hover {
      /* Efeito hover no botão adicionar */
      background: #218838;
    }

    .btn-gerenciar-oms {
      /* Botão gerenciar OMs */
      background: #17a2b8;
      padding: 8px 12px;
      font-size: 13px;
    }

    .btn-gerenciar-oms:hover {
      /* Efeito hover no botão gerenciar OMs */
      background: #138496;
    }
  </style>
  <!-- Fim da seção de estilos -->
</head>
