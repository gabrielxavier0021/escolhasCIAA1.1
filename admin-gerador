    /* Responsividade */
    @media (max-width: 1300px) {

      /* Media query para telas menores */
      body {
        padding: 15px;
      }

      table {
        font-size: 13px;
      }

      th,
      td {
        padding: 12px 8px;
      }

      /* Ajustes de largura para responsividade */
