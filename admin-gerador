  <script>
    // Início da seção JavaScript
    // Dados do JSON externo (simulação)
    let jsonExterno = {
      // Objeto com dados externos de exemplo
      "dados": [
        // Array de dados externos
        { "codigo": "a1b2c3d4e5", "numero_interno": "ACI2-205" },
        { "codigo": "f6g7h8i9j0", "numero_interno": "ACI2-206" },
        { "codigo": "k1l2m3n4o5", "numero_interno": "ACI2-207" },
        { "codigo": "p6q7r8s9t0", "numero_interno": "ACI2-208" },
        { "codigo": "u1v2w3x4y5", "numero_interno": "ACI2-209" }
      ]
    };

    // Lista padrão de OMs ATUALIZADA
    const OMS_PADRAO = [
      // Array constante com lista padrão de OMs
      "CADIM",
      "COM 1 DN",
      "COM 1 DN Espírito Santo",
      "COM 1 DN fora de sede rj",
      "COM 1 DN minas gerais",
      "COM 2 DN",
      "COM 3 DN",
      "COM 4 DN",
      "COM 5 DN",
      "COM 6 DN",
      "COM 7 DN",
      "COM 8 DN",
      "COM 9 DN",
      "Comemch",
      "comFFE",
      "CPesFN",
      "DAbM",
      "DADM",
      "DENSM",
      "DEnsM/CN",
      "DFM",
      "DFM/SGM",
      "DHN",
      "DIM",
      "DPC",
      "DPM",
      "DPM/ SP",
      "DPM/DF",
      "DPM/IEAPM",
      "DSAM",
      "DSM",
      "DSM/SNNF",
      "Itaguaí"
    ];

    // Carregar OMs do localStorage ou usar padrão
    function carregarOMs() {
      // Função para carregar lista de OMs
      const omsSalvas = localStorage.getItem("listaOMs");
      // Obtém OMs do localStorage
      if (omsSalvas) {
        // Se encontrou OMs salvas
        return JSON.parse(omsSalvas);
        // Retorna OMs parseadas
      } else {
        // Se não encontrou OMs salvas
        // Salva a lista padrão no localStorage na primeira vez
        salvarOMs(OMS_PADRAO);
        // Salva lista padrão
        return OMS_PADRAO;
        // Retorna lista padrão
      }
    }

    // Salvar OMs no localStorage
    function salvarOMs(oms) {
      // Função para salvar lista de OMs
      localStorage.setItem("listaOMs", JSON.stringify(oms));
      // Salva OMs no localStorage
    }

    // Atualizar OMs no sistema de autenticação
    function atualizarOMsNoSistemaAutenticacao() {
      // Função para atualizar OMs no outro sistema
      const omsAtuais = carregarOMs();
      // Carrega OMs atuais
      // Esta função seria chamada quando o sistema de autenticação estiver aberto
      console.log("OMs atualizadas:", omsAtuais);
      // Log das OMs atualizadas
    }

    // Mostrar modal de gerenciamento de OMs
    function mostrarModalOMs() {
      // Função para mostrar modal de OMs
      const modal = document.getElementById("modalOMs");
      // Obtém elemento modal
      modal.style.display = "block";
      // Mostra modal
      atualizarListaOMs();
      // Atualiza lista de OMs no modal
    }

    // Fechar modal de OMs
    function fecharModalOMs() {
      // Função para fechar modal de OMs
      const modal = document.getElementById("modalOMs");
      // Obtém elemento modal
      modal.style.display = "none";
      // Esconde modal
    }

    // Atualizar a lista de OMs no modal
    function atualizarListaOMs() {
      // Função para atualizar lista de OMs no modal
      const listaOMs = document.getElementById("listaOMs");
      // Obtém container da lista
      const oms = carregarOMs();
      // Carrega OMs

      listaOMs.innerHTML = '';
      // Limpa lista

      if (oms.length === 0) {
        // Se não há OMs
        listaOMs.innerHTML = '<p style="text-align: center; color: #6c757d;">Nenhuma OM cadastrada</p>';
        // Mostra mensagem de lista vazia
        return;
      }

      oms.forEach((om, index) => {
        // Para cada OM
        const div = document.createElement('div');
        // Cria div do item
        div.className = 'om-item';
        // Adiciona classe
        div.innerHTML = `
    <!-- HTML do item de OM -->
      <span>${om}</span>
      <!-- Nome da OM -->
      <button class="btn-excluir" data-index="${index}">Excluir</button>
      <!-- Botão excluir -->
    `;
        listaOMs.appendChild(div);
        // Adiciona item à lista
      });

      // Adicionar eventos aos botões de excluir
      document.querySelectorAll('.btn-excluir').forEach(btn => {
        // Para cada botão excluir
        btn.addEventListener('click', function () {
          // Adiciona evento de clique
          const index = parseInt(this.getAttribute('data-index'));
          // Obtém índice do atributo data
          excluirOM(index);
          // Chama função excluir
        });
      });
    }

    // Adicionar nova OM
    function adicionarOM() {
      // Função para adicionar nova OM
      const input = document.getElementById('novaOM');
      // Obtém input da nova OM
      const nomeOM = input.value.trim();
      // Obtém e limpa valor

      if (!nomeOM) {
        // Se nome está vazio
        alert('Por favor, digite o nome da OM.');
        // Alerta usuário
        return;
      }

      if (nomeOM.length > 50) {
        // Se nome é muito longo
        alert('O nome da OM deve ter no máximo 50 caracteres.');
        // Alerta usuário
        return;
      }

      const oms = carregarOMs();
      // Carrega OMs atuais

      // Verificar se já existe
      if (oms.includes(nomeOM)) {
        // Se OM já existe
        alert('Esta OM já está cadastrada.');
        // Alerta usuário
        return;
      }

      oms.push(nomeOM);
      // Adiciona nova OM
      salvarOMs(oms);
      // Salva lista atualizada
      atualizarListaOMs();
      // Atualiza lista no modal
      input.value = '';
      // Limpa input

      alert('OM adicionada com sucesso!');
      // Alerta sucesso
    }

    // Excluir OM
    function excluirOM(index) {
      // Função para excluir OM
      if (!confirm('Tem certeza que deseja excluir esta OM?')) {
        // Confirma exclusão
        return;
      }

      const oms = carregarOMs();
      // Carrega OMs
      oms.splice(index, 1);
      // Remove OM pelo índice
      salvarOMs(oms);
      // Salva lista atualizada
      atualizarListaOMs();
      // Atualiza lista no modal

      alert('OM excluída com sucesso!');
      // Alerta sucesso
    }

    // Restaurar lista padrão de OMs
    function restaurarOMsPadrao() {
      // Função para restaurar lista padrão
      if (!confirm('Isso irá restaurar a lista padrão de OMs e remover todas as personalizações. Continuar?')) {
        // Confirma restauração
        return;
      }

      salvarOMs(OMS_PADRAO);
      // Salva lista padrão
      atualizarListaOMs();
      // Atualiza lista no modal
      alert('Lista de OMs restaurada para o padrão!');
      // Alerta sucesso
    }

    async function gerarHash(texto) {
      // Função assíncrona para gerar hash
      const buffer = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(texto));
      // Gera hash SHA-256
      const hashArray = Array.from(new Uint8Array(buffer));
      // Converte buffer para array
      return hashArray.map(b => b.toString(16).padStart(2, "0")).join("").slice(0, 10);
      // Converte para string hexadecimal e retorna primeiros 10 caracteres
    }

    const form = document.getElementById("formPessoa");
    // Obtém elemento do formulário
    const tabela = document.querySelector("#tabela tbody");
    // Obtém corpo da tabela
    let sortOrder = {};
    // Objeto para armazenar ordem de classificação
    let originalData = []; // Armazena os dados na ordem original

    // Salvar novo registro
    function salvarLocalmente(nome, nip, email, codigo, data, ultimaAlteracao, numeroInterno) {
      // Função para salvar registro localmente
      const lista = JSON.parse(localStorage.getItem("listaPessoal") || "[]");
      // Obtém lista do localStorage ou array vazio
      lista.push({ nome, nip, email, codigo, data, ultimaAlteracao, numeroInterno });
      // Adiciona novo registro
      localStorage.setItem("listaPessoal", JSON.stringify(lista));
      // Salva lista atualizada
    }

    // Carregar lista
    function carregarLista(lista = null) {
      // Função para carregar lista na tabela
      tabela.innerHTML = "";
      // Limpa tabela
      const dados = lista || JSON.parse(localStorage.getItem("listaPessoal") || "[]");
      // Obtém dados da lista ou do localStorage
      originalData = [...dados]; // Mantém cópia dos dados originais
      dados.forEach(({ nome, nip, email, codigo, data, ultimaAlteracao, numeroInterno }) => {
        // Para cada registro
        const linha = document.createElement("tr");
        // Cria linha da tabela
        linha.innerHTML = `
    <!-- HTML da linha da tabela -->
      <td class="editable nome">${nome}</td>
      <!-- Célula nome (editável) -->
      <td class="editable nip">${nip}</td>
      <!-- Célula NIP (editável) -->
      <td>${email || "-"}</td>
      <!-- Célula email -->
      <td class="codigo">${codigo}</td>
      <!-- Célula código -->
      <td class="numero-interno">${numeroInterno || "-"}</td>
      <!-- Célula número interno -->
      <td>${data}</td>
      <!-- Célula data -->
      <td class="ultimaAlteracao">${ultimaAlteracao || "-"}</td>
      <!-- Célula última alteração -->
      <td></td>
      <!-- Célula vazia para alinhamento -->
    `;
        tabela.appendChild(linha);
        // Adiciona linha à tabela
      });
    }

    // Função para comparar códigos e atualizar números internos
    function atualizarNumerosInternos() {
      // Função para atualizar números internos
      const lista = JSON.parse(localStorage.getItem("listaPessoal") || "[]");
      // Obtém lista do localStorage
      let atualizou = false;
      // Flag de atualização

      lista.forEach(pessoa => {
        // Para cada pessoa na lista
        const correspondencia = jsonExterno.dados.find(item => item.codigo === pessoa.codigo);
        // Busca correspondência no JSON externo
        if (correspondencia && (!pessoa.numeroInterno || pessoa.numeroInterno !== correspondencia.numero_interno)) {
          // Se encontrou correspondência e número interno é diferente
          pessoa.numeroInterno = correspondencia.numero_interno;
          // Atualiza número interno
          atualizou = true;
          // Marca como atualizado
        }
      });

      if (atualizou) {
        // Se houve atualizações
        localStorage.setItem("listaPessoal", JSON.stringify(lista));
        // Salva lista atualizada
        carregarLista();
        // Recarrega tabela
        alert("Números internos atualizados com sucesso!");
        // Alerta sucesso
      } else {
        // Se não houve atualizações
        alert("Nenhum número interno foi atualizado. Verifique se há correspondências nos códigos.");
        // Alerta usuário
      }
    }

    // Filtros
    function aplicarFiltros() {
      // Função para aplicar filtros
      let lista = JSON.parse(localStorage.getItem("listaPessoal") || "[]");
      // Obtém lista do localStorage
      const nomeFiltro = document.getElementById("pesquisaNome").value.trim().toLowerCase();
      // Obtém e formata filtro nome
      const nipFiltro = document.getElementById("pesquisaNip").value.trim();
      // Obtém filtro NIP
      const codigoFiltro = document.getElementById("pesquisaCodigo").value.trim().toLowerCase();
      // Obtém e formata filtro código
      const numeroInternoFiltro = document.getElementById("pesquisaNumeroInterno").value.trim().toLowerCase();
      // Obtém e formata filtro número interno

      if (nomeFiltro) lista = lista.filter(p => p.nome.toLowerCase().includes(nomeFiltro));
      // Filtra por nome se especificado
      if (nipFiltro) lista = lista.filter(p => p.nip.includes(nipFiltro));
      // Filtra por NIP se especificado
      if (codigoFiltro) lista = lista.filter(p => p.codigo.toLowerCase().includes(codigoFiltro));
      // Filtra por código se especificado
      if (numeroInternoFiltro) lista = lista.filter(p => p.numeroInterno && p.numeroInterno.toLowerCase().includes(numeroInternoFiltro));
      // Filtra por número interno se especificado

      carregarLista(lista);
      // Carrega lista filtrada
    }

    // Limpar filtros
    document.getElementById("limparFiltros").addEventListener("click", () => {
      // Evento de clique no botão limpar filtros
      document.getElementById("pesquisaNome").value = "";
      // Limpa filtro nome
      document.getElementById("pesquisaNip").value = "";
      // Limpa filtro NIP
      document.getElementById("pesquisaCodigo").value = "";
      // Limpa filtro código
      document.getElementById("pesquisaNumeroInterno").value = "";
      // Limpa filtro número interno
      carregarLista();
      // Recarrega lista sem filtros
    });

    // Mostrar/ocultar filtros
    function mostrarFiltros() {
      // Função para mostrar filtros
      const filtros = document.getElementById("filtros");
      // Obtém elemento filtros
      const overlay = document.getElementById("overlay");
      // Obtém elemento overlay
      filtros.style.display = "block";
      // Mostra filtros
      overlay.style.display = "block";
      // Mostra overlay
    }

    function ocultarFiltros() {
      // Função para ocultar filtros
      const filtros = document.getElementById("filtros");
      // Obtém elemento filtros
      const overlay = document.getElementById("overlay");
      // Obtém elemento overlay
      filtros.style.display = "none";
      // Esconde filtros
      overlay.style.display = "none";
      // Esconde overlay
    }

    document.getElementById("toggleFiltros").addEventListener("click", (e) => {
      // Evento de clique no botão toggle filtros
      e.stopPropagation();
      // Impede propagação do evento
      const filtros = document.getElementById("filtros");
      // Obtém elemento filtros
      if (filtros.style.display === "block") {
        // Se filtros estão visíveis
        ocultarFiltros();
        // Oculta filtros
      } else {
        // Se filtros estão ocultos
        mostrarFiltros();
        // Mostra filtros
      }
    });

    // Fechar filtros ao clicar fora
    document.getElementById("overlay").addEventListener("click", ocultarFiltros);
    // Fecha filtros ao clicar no overlay
    document.addEventListener("click", (e) => {
      // Fecha filtros ao clicar fora
      const filtros = document.getElementById("filtros");
      // Obtém elemento filtros
      const toggleBtn = document.getElementById("toggleFiltros");
      // Obtém botão toggle

      if (filtros.style.display === "block" &&
        // Se filtros estão visíveis
        !filtros.contains(e.target) &&
        // E clique não foi dentro dos filtros
        !toggleBtn.contains(e.target)) {
        // E clique não foi no botão toggle
        ocultarFiltros();
        // Oculta filtros
      }
    });

    // Aplicar filtros em tempo real
    document.getElementById("pesquisaNome").addEventListener("input", aplicarFiltros);
    // Aplica filtro nome em tempo real
    document.getElementById("pesquisaNip").addEventListener("input", aplicarFiltros);
    // Aplica filtro NIP em tempo real
    document.getElementById("pesquisaCodigo").addEventListener("input", aplicarFiltros);
    // Aplica filtro código em tempo real
    document.getElementById("pesquisaNumeroInterno").addEventListener("input", aplicarFiltros);
    // Aplica filtro número interno em tempo real

    // Validar NIP - apenas números
    document.getElementById("nip").addEventListener("input", function (e) {
      // Validação do campo NIP em tempo real
      this.value = this.value.replace(/[^0-9]/g, '');
      // Remove caracteres não numéricos
      if (this.value.length > 8) {
        // Se tem mais de 8 caracteres
        this.value = this.value.slice(0, 8);
        // Corta para 8 caracteres
      }
    });

    // Cadastro
    form.addEventListener("submit", async e => {
      // Evento de submit do formulário
      e.preventDefault();
      // Previne comportamento padrão
      const nome = document.getElementById("nome").value.trim();
      // Obtém nome
      const nip = document.getElementById("nip").value.trim();
      // Obtém NIP
      const email = document.getElementById("email").value.trim();
      // Obtém email
      const data = new Date().toLocaleString("pt-BR");
      // Obtém data atual

      if (!/^[0-9]{8}$/.test(nip)) {
        // Valida NIP (8 números)
        alert("O NIP deve conter exatamente 8 números.");
        // Alerta erro
        return;
      }

      if (!nome) {
        // Valida nome
        alert("Preencha o nome.");
        // Alerta erro
        return;
      }

      const lista = JSON.parse(localStorage.getItem("listaPessoal") || "[]");
      // Obtém lista atual
      if (lista.some(p => p.nip === nip)) {
        // Verifica se NIP já existe
        alert("Este NIP já foi cadastrado.");
        // Alerta erro
        return;
      }

      const codigo = await gerarHash(nome + nip + email + Date.now());
      // Gera código único
      salvarLocalmente(nome, nip, email, codigo, data, null, null);
      // Salva registro
      carregarLista();
      // Recarrega tabela
      form.reset();
      // Limpa formulário
    });

    // Edição
    tabela.addEventListener("dblclick", e => {
      // Evento de duplo clique para edição
      const alvo = e.target;
      // Obtém elemento clicado
      if (alvo.classList.contains("editable")) {
        // Se elemento é editável
        const valorAntigo = alvo.textContent;
        // Obtém valor atual
        let novoValor = prompt("Alterar valor:", valorAntigo);
        // Pede novo valor

        if (novoValor !== null) {
          // Se usuário não cancelou
          // Para NIP, remove caracteres não numéricos
          if (alvo.classList.contains("nip")) {
            // Se é campo NIP
            novoValor = novoValor.replace(/[^0-9]/g, '');
            // Remove não numéricos
            if (novoValor.length > 8) {
              // Se tem mais de 8 caracteres
              novoValor = novoValor.slice(0, 8);
              // Corta para 8
            }
          }

          const linha = alvo.parentElement;
          // Obtém linha da tabela
          const lista = JSON.parse(localStorage.getItem("listaPessoal") || "[]");
          // Obtém lista
          const index = Array.from(tabela.rows).indexOf(linha);
          // Obtém índice da linha

          if (alvo.classList.contains("nip")) {
            // Validações específicas para NIP
            if (!/^[0-9]{8}$/.test(novoValor)) {
              // Valida formato NIP
              alert("O NIP deve conter exatamente 8 números.");
              return;
            }
            if (lista.some((p, i) => p.nip === novoValor && i !== index)) {
              // Verifica duplicidade
              alert("Este NIP já está cadastrado.");
              return;
            }
          }

          alvo.textContent = novoValor;
          // Atualiza valor na tabela
          const registro = lista[index];
          // Obtém registro
          if (alvo.classList.contains("nome")) registro.nome = novoValor;
          // Atualiza nome
          if (alvo.classList.contains("nip")) registro.nip = novoValor;
          // Atualiza NIP
          registro.ultimaAlteracao = new Date().toLocaleString("pt-BR");
          // Atualiza data de alteração
          linha.querySelector(".ultimaAlteracao").textContent = registro.ultimaAlteracao;
          // Atualiza na tabela
          localStorage.setItem("listaPessoal", JSON.stringify(lista));
          // Salva lista
          aplicarFiltros();
          // Reaplica filtros
        }
      }
    });

    // Ordenação com três estados: original, ascendente, descendente
    document.querySelectorAll("#tabela th.sortable").forEach(th => {
      // Adiciona eventos de ordenação aos cabeçalhos
      th.addEventListener("click", () => {
        // Evento de clique no cabeçalho
        const col = th.getAttribute("data-col");
        // Obtém coluna para ordenar

        let lista = JSON.parse(localStorage.getItem("listaPessoal") || "[]");
        // Obtém lista
        const current = sortOrder[col] || "original";
        // Obtém estado atual de ordenação

        // Ciclo: original -> asc -> desc -> original
        let next;
        // Próximo estado
        switch (current) {
          case "original": next = "asc"; break;
          case "asc": next = "desc"; break;
          case "desc": next = "original"; break;
        }
        sortOrder[col] = next;
        // Atualiza estado

        // Atualiza ícones
        document.querySelectorAll("#tabela th .sort-icon").forEach(span => span.textContent = "");
        // Limpa todos os ícones
        const icone = th.querySelector(".sort-icon");
        // Obtém ícone deste cabeçalho

        if (next === "original") {
          // Se voltando à ordem original
          icone.textContent = "";
          // Remove ícone
          // Restaura ordem original (por data de criação)
          lista.sort((a, b) => new Date(a.data) - new Date(b.data));
          // Ordena por data
        } else {
          // Se ordenando
          icone.textContent = next === "asc" ? "▲" : "▼";
          // Define ícone

          // Ordena a lista
          lista.sort((a, b) => {
            // Função de comparação
            let va = a[col] || "";
            let vb = b[col] || "";

            if (col === "nip") {
              // Ordenação numérica para NIP
              return next === "asc" ? Number(va) - Number(vb) : Number(vb) - Number(va);
            } else {
              // Ordenação alfabética para Nome
              return next === "asc" ? va.toString().localeCompare(vb.toString()) : vb.toString().localeCompare(va.toString());
            }
          });
        }

        carregarLista(lista);
        // Recarrega tabela ordenada
      });
    });

    // Função de exportação CSV
    document.getElementById("exportCSV").addEventListener("click", function () {
      // Evento de exportação CSV
      const lista = JSON.parse(localStorage.getItem("listaPessoal") || "[]");
      // Obtém lista

      if (lista.length === 0) {
        // Se lista está vazia
        alert("Não há dados para exportar.");
        // Alerta usuário
        return;
      }

      // Cabeçalhos
      const headers = ["Nome", "NIP", "Email", "Código", "Número Interno", "Data/Hora", "Última Alteração"];
      // Define cabeçalhos

      // Linhas de dados
      const csvRows = [headers.join(",")];
      // Array de linhas CSV

      lista.forEach(item => {
        // Para cada item
        const row = [
          // Cria linha
          `"${item.nome}"`,
          item.nip,
          `"${item.email || ''}"`,
          item.codigo,
          `"${item.numeroInterno || ''}"`,
          `"${item.data}"`,
          `"${item.ultimaAlteracao || ''}"`
        ];
        csvRows.push(row.join(","));
        // Adiciona linha
      });

      const csvString = csvRows.join("\n");
      // Junta todas as linhas
      const blob = new Blob([csvString], { type: "text/csv;charset=utf-8;" });
      // Cria blob
      const url = URL.createObjectURL(blob);
      // Cria URL

      const link = document.createElement("a");
      // Cria link
      link.setAttribute("href", url);
      // Define href
      link.setAttribute("download", "lista_pessoal.csv");
      // Define nome do arquivo
      link.style.visibility = "hidden";
      // Esconde link

      document.body.appendChild(link);
      // Adiciona link ao body
      link.click();
      // Simula clique
      document.body.removeChild(link);
      // Remove link
    });

    // Função de exportação JSON
    document.getElementById("exportJSON").addEventListener("click", function () {
      // Evento de exportação JSON
      const lista = JSON.parse(localStorage.getItem("listaPessoal") || "[]");
      // Obtém lista

      if (lista.length === 0) {
        // Se lista está vazia
        alert("Não há dados para exportar.");
        // Alerta usuário
        return;
      }

      const jsonString = JSON.stringify(lista, null, 2);
      // Converte para JSON formatado
      const blob = new Blob([jsonString], { type: "application/json;charset=utf-8;" });
      // Cria blob
      const url = URL.createObjectURL(blob);
      // Cria URL

      const link = document.createElement("a");
      // Cria link
      link.setAttribute("href", url);
      // Define href
      link.setAttribute("download", "lista_pessoal.json");
      // Define nome do arquivo
      link.style.visibility = "hidden";
      // Esconde link

      document.body.appendChild(link);
      // Adiciona link ao body
      link.click();
      // Simula clique
      document.body.removeChild(link);
      // Remove link
    });

    // Botões de configuração
    document.getElementById("gerenciarOMs").addEventListener("click", mostrarModalOMs);
    // Evento gerenciar OMs

    // Eventos do modal de OMs
    document.getElementById("adicionarOM").addEventListener("click", adicionarOM);
    // Evento adicionar OM
    document.getElementById("restaurarPadrao").addEventListener("click", restaurarOMsPadrao);
    // Evento restaurar padrão
    document.getElementById("fecharModal").addEventListener("click", fecharModalOMs);
    // Evento fechar modal

    // Fechar modal ao clicar no X
    document.querySelector(".close").addEventListener("click", fecharModalOMs);
    // Evento fechar modal no X

    // Fechar modal ao clicar fora dele
    window.addEventListener("click", function (event) {
      // Fecha modal ao clicar fora
      const modal = document.getElementById("modalOMs");
      // Obtém modal
      if (event.target === modal) {
        // Se clique foi no modal (fora do conteúdo)
        fecharModalOMs();
        // Fecha modal
      }
    });

    // Adicionar OM com Enter
    document.getElementById("novaOM").addEventListener("keypress", function (e) {
      // Adiciona OM com tecla Enter
      if (e.key === "Enter") {
        // Se tecla Enter
        adicionarOM();
        // Chama função adicionar
      }
    });

    carregarLista();
    // Carrega lista ao inicializar
  </script>
