<!DOCTYPE html>
<!-- Declaração do tipo de documento HTML5 -->
<html lang="pt-BR">
<!-- Elemento raiz do documento com idioma português brasileiro -->

<head>
  <!-- Cabeçalho do documento com metadados -->
  <meta charset="UTF-8">
  <!-- Define a codificação de caracteres como UTF-8 para suportar acentos -->
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <!-- Configura viewport para responsividade em dispositivos móveis -->
  <title>Sistema de Autenticação - 5 Páginas</title>
  <!-- Título da página que aparece na aba do navegador -->
  <style>
    /* Início da seção de estilos CSS */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Inter', sans-serif;
    }

    /* Reset CSS: remove margens/paddings padrão, define box-sizing e fonte */
    body {
      background: #f8f9fa;
      color: #2c3e50;
    }

    /* Estilo do corpo: cor de fundo cinza claro e texto azul escuro */

    .container {
      max-width: 700px;
      margin: 50px auto;
      padding: 40px;
      border-radius: 12px;
      background: #ffffff;
    }

    /* Container principal: largura máxima, centralizado, com padding e bordas arredondadas */

    h2 {
      margin-bottom: 25px;
      font-weight: 600;
      font-size: 1.8rem;
      color: #2c3e50;
    }

    /* Estilo para títulos h2 */
    h3 {
      margin-bottom: 12px;
      font-weight: 500;
      font-size: 1.2rem;
      color: #34495e;
    }

    /* Estilo para títulos h3 */

    label {
      display: block;
      font-weight: 500;
      color: #34495e;
      font-size: 0.95rem;
      margin-bottom: 5px;
    }

    /* Estilo para labels: em bloco, com peso de fonte e cor específicos */

    input,
    select {
      /* Estilo comum para inputs e selects */
      padding: 10px 14px;
      border-radius: 8px;
      border: 1px solid #d1d3d6;
      font-size: 16px;
      transition: all 0.2s ease;
      background: #fff;
      color: #2c3e50;
      width: 100%;
      margin-bottom: 18px;
    }

    input:focus,
    select:focus {
      outline: none;
      border-color: #3498db;
    }

    /* Estilo para foco nos campos: remove outline e muda cor da borda */

    button {
      /* Estilo base para todos os botões */
      padding: 12px 26px;
      border: none;
      border-radius: 8px;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.5s ease;
      margin-right: 8px;
    }

    button:hover:not(:disabled) {
      transform: translateY(-1px);
    }

    /* Efeito hover: levanta o botão 1px */
    button:active:not(:disabled) {
      transform: translateY(0);
    }

    /* Efeito active: retorna à posição original */

    /* Classes de cor para diferentes tipos de botões */
    .btn-avancar {
      background: #3498db;
      color: white;
    }

    .btn-voltar {
      background: #7f8c8d;
      color: white;
    }

    .btn-inicio {
      background: #1494e9;
      color: white;
    }

    .btn-imprimir {
      background: #2c3e50;
      color: white;
    }

    .btn-confirmar {
      background: #28a745;
      color: white;
    }

    .btn-verificar {
      background: #2980b9;
      color: white;
    }

    button:disabled {
      background: #bdc3c7 !important;
      cursor: not-allowed;
    }

    /* Estilo para botões desabilitados: cor cinza e cursor não permitido */

    .hidden {
      display: none;
    }

    /* Classe utilitária para esconder elementos */

    .option-list {
      display: flex;
      flex-direction: column;
    }

    /* Container para lista de opções usando flexbox em coluna */
    .option-item {
      /* Item individual da lista de opções */
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 8px 12px;
      border-bottom: 1px solid #e0e0e0;
      transition: background 0.2s;
    }

    .option-item:nth-child(odd) {
      background: #fbfcfd;
    }

    /* Zebra: cor de fundo alternada para linhas ímpares */
    .option-item label {
      margin-right: 12px;
      width: 120px;
    }

    /* Label dentro do item com largura fixa */
    .option-item select {
      /* Select personalizado dentro dos itens */
      -webkit-appearance: none;
      -moz-appearance: none;
      appearance: none;
      /* Remove aparência nativa do select */
      background: #fff url('data:image/svg+xml;utf8,<svg fill="%233498db" height="20" viewBox="0 0 24 24" width="20" xmlns="http://www.w3.org/2000/svg"><path d="M7 10l5 5 5-5z"/></svg>') no-repeat right 12px center;
      /* Adiciona seta personalizada como background */
      background-size: 16px;
      padding-right: 40px;
      border-radius: 10px;
      border: 1px solid #d1d3d6;
      transition: all 0.2s ease;
      width: 200px;
    }

    .option-item select:hover {
      border-color: #3498db;
    }

    /* Efeito hover no select */
    .option-item select:focus {
      outline: none;
      border-color: #2980b9;
      box-shadow: 0 0 6px rgba(52, 152, 219, 0.2);
    }

    /* Efeito focus com shadow */

    .final-container {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    /* Container final com layout em coluna e gap */
    .final-box {
      background: #ffffff;
      padding: 20px;
      border-radius: 10px;
      border: 1px solid #d1d3d6;
    }

    /* Caixa individual no container final */
    pre {
      white-space: pre-wrap;
      font-family: 'Courier New', monospace;
      font-size: 0.95rem;
      color: #2c3e50;
    }

    /* Estilo para texto pré-formatado (monoespaçado) */

    .toast {
      /* Notificação toast (popup) */
      position: fixed;
      bottom: 20px;
      right: 20px;
      background: #000000cc;
      color: white;
      padding: 12px 20px;
      border-radius: 8px;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.4s ease, transform 0.3s ease;
      transform: translateY(15px);
      font-weight: 500;
    }

    .toast.show {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0);
    }

    /* Classe para mostrar o toast */

    .error-message {
      color: #e74c3c;
      font-size: 0.9rem;
      margin-top: -15px;
      margin-bottom: 15px;
    }

    /* Mensagens de erro em vermelho */
    .success-message {
      color: #27ae60;
      font-size: 0.9rem;
      margin-top: -15px;
      margin-bottom: 15px;
    }

    /* Mensagens de sucesso em verde */

    .campo-bloqueado {
      /* Campos que não podem ser editados */
      background-color: #f8f9fa;
      border: 1px solid #d1d3d6;
      color: #6c757d;
      cursor: not-allowed;
    }

    .info-campo {
      /* Texto informativo abaixo dos campos */
      font-size: 0.85rem;
      color: #6c757d;
      margin-top: -10px;
      margin-bottom: 15px;
      font-style: italic;
    }

    .campo-opcional {
      /* Indicação de campo opcional */
      font-size: 0.85rem;
      color: #6c757d;
      margin-top: -10px;
      margin-bottom: 15px;
    }

    .navegacao-sistemas {
      /* Navegação entre sistemas */
      display: flex;
      justify-content: center;
      gap: 20px;
      margin-bottom: 30px;
      padding: 20px;
      background: white;
      border-radius: 10px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .btn-sistema {
      /* Botões de navegação do sistema */
      padding: 15px 30px;
      background: #3498db;
      color: white;
      border: none;
      border-radius: 8px;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s ease;
    }

    .btn-sistema:hover {
      /* Efeito hover nos botões do sistema */
      background: #2980b9;
      transform: translateY(-2px);
    }

    .btn-sistema.ativo {
      /* Botão do sistema ativo */
      background: #2c3e50;
    }

    /* Estilos para os selects de graduação e especialidade */
    .graduacao-especialidade-container {
      /* Container para os dois selects lado a lado */
      display: flex;
      gap: 15px;
      margin-bottom: 18px;
    }

    .graduacao-especialidade-container>div {
      /* Divisões dentro do container */
      flex: 1;
    }

    .graduacao-especialidade-container label {
      /* Labels dentro do container */
      font-size: 0.85rem;
      margin-bottom: 5px;
      color: #34495e;
      font-weight: 500;
    }

    .select-group {
      /* Grupo de select com label */
      display: flex;
      flex-direction: column;
    }
  </style>
  <!-- Fim da seção de estilos -->
</head>
<!-- Fim do cabeçalho -->

<body>
  <!-- Início do corpo do documento -->

  <!-- Navegação entre sistemas (comentada) -->
  <!--<div class="navegacao-sistemas">
