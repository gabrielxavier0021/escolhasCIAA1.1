  <!-- Página 1: Verificação do Código -->
  <div class="container" id="page1">
    <!-- Primeira página - container principal -->
    <h2>Verificação de Autenticidade</h2>
    <!-- Título da página -->
    <p>Digite seu código único para verificação:</p>
    <!-- Instrução para o usuário -->
    <input type="text" id="codigoVerificacao" placeholder="Ex: a1b2c3d4e5">
    <!-- Campo de entrada para o código -->
    <button class="btn-verificar" id="verificarCodigo">Verificar Código</button>
    <!-- Botão para verificar o código -->
    <p id="mensagemVerificacao" style="margin-top:15px;font-weight:500;"></p>
