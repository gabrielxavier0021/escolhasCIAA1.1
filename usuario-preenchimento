  </div>
  <!-- Fim da página 1 -->

  <!-- Página 2: Dados Pessoais -->
  <div class="container hidden" id="page2">
    <!-- Segunda página - inicialmente escondida -->
    <h2>Dados Pessoais</h2>
    <!-- Título da página -->

    <label for="nomeCompleto">Nome completo *</label>
    <!-- Label para campo nome -->
    <input type="text" id="nomeCompleto" placeholder="Ex: JOÃO DA SILVA" readonly class="campo-bloqueado">
    <!-- Campo de nome (somente leitura) -->
    <div class="info-campo">Nome definido automaticamente pelo código de verificação</div>
    <!-- Informação sobre o campo -->

    <label for="nip">NIP *</label>
    <!-- Label para campo NIP -->
    <input type="text" id="nip" maxlength="8" placeholder="12345678" readonly class="campo-bloqueado">
    <!-- Campo NIP (somente leitura, máximo 8 caracteres) -->
    <div class="info-campo">NIP definido automaticamente pelo código de verificação</div>
    <!-- Informação sobre o campo -->

    <label for="email">Email</label>
    <!-- Label para campo email -->
    <input type="email" id="emailAuth" placeholder="exemplo@email.com (opcional)">
    <!-- Campo email (opcional) -->
    <div class="campo-opcional">Campo opcional</div>
    <!-- Indicação de campo opcional -->

    <label for="numeroInterno">Número Interno *</label>
    <!-- Label para número interno -->
    <input type="text" id="numeroInternoAuth" placeholder="ACI1-101">
    <!-- Campo número interno -->
    <div id="erroNumeroInterno" class="error-message hidden">Número interno é obrigatório</div>
    <!-- Mensagem de erro (inicialmente escondida) -->

    <label for="graduacaoEspecialidade">Graduação e Especialidade *</label>
    <!-- Label para graduação e especialidade -->

    <div class="graduacao-especialidade-container">
      <!-- Container para os dois selects -->
      <div class="select-group">
        <!-- Grupo do select de graduação -->
        <label for="graduacao">Graduação</label>
        <!-- Label para graduação -->
        <select id="graduacao">
          <!-- Select de graduação -->
          <option value="">-- Selecione --</option>
          <!-- Opção padrão -->
          <option value="AL">AL</option>
          <!-- Opções de graduação -->
          <option value="MN">MN</option>
          <option value="SD">SD</option>
          <option value="CB">CB</option>
          <option value="3SG">3SG</option>
          <option value="2SG">2SG</option>
          <option value="1SG">1SG</option>
